{
  "name": "puzzle-universe",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo do Puzzle Universe — Nostalgia Puzzle 90's e Bible Puzzle Adventures",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:nostalgia": "npm run dev -w @puzzle-universe/nostalgia-90",
    "dev:bible": "npm run dev -w @puzzle-universe/bible-puzzle",
    "build": "npm run build -w @puzzle-universe/nostalgia-90 && npm run build -w @puzzle-universe/bible-puzzle",
    "build:nostalgia": "npm run build -w @puzzle-universe/nostalgia-90",
    "build:bible": "npm run build -w @puzzle-universe/bible-puzzle",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "validate:catalog": "tsx packages/content-manager/src/cli.ts --catalog assets/nostalgia/catalog.json --catalog assets/bible/catalog.json --min 10 --warn-below 200",
    "assets:rasterize": "tsx scripts/rasterize-assets.ts",
    "assets:optimize": "tsx scripts/optimize-lote.ts",
    "preview:nostalgia": "npm run preview -w @puzzle-universe/nostalgia-90",
    "preview:bible": "npm run preview -w @puzzle-universe/bible-puzzle"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fake-indexeddb": "^6.0.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.6"
  }
}
